{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "zig build",
      "type": "shell",
      "command": "zig",
      "args": [
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "reset target",
      "type": "shell",
      "command": "probe-rs",
      "args": [
        "reset",
        "--chip",
        "RP235x"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "silent",
        "close": true
      },
      "problemMatcher": []
    }
  ]
}