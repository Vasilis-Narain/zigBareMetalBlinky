{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "blinky: OpenOCD (Pico extension)",
      "type": "cortex-debug",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/zig-out/bin/blinky",
      "servertype": "openocd",
      "serverpath": "${command:raspberry-pi-pico.getOpenOCDRoot}/openocd.exe",
      "gdbPath": "${command:raspberry-pi-pico.getGDBPath}",
      "searchDir": [
        "${command:raspberry-pi-pico.getOpenOCDRoot}/scripts"
      ],
      "configFiles": [
        "interface/cmsis-dap.cfg",
        "target/rp2350.cfg"
      ],
      "openOCDLaunchCommands": [
        "adapter speed 5000"
      ],
      "svdFile": "C:/Users/Vasilis/pico-sdk/src/rp2350/hardware_regs/RP2350.svd",
      "preLaunchTask": "zig build",
      "runToEntryPoint": "main.main",
      "postDebugTask": "reset target"
    },
    {
      "name": "blinky: OpenOCD attach (no flash)",
      "type": "cortex-debug",
      "request": "attach",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/zig-out/bin/blinky",
      "servertype": "openocd",
      "serverpath": "${command:raspberry-pi-pico.getOpenOCDRoot}/openocd.exe",
      "gdbPath": "${command:raspberry-pi-pico.getGDBPath}",
      "searchDir": [
        "${command:raspberry-pi-pico.getOpenOCDRoot}/scripts"
      ],
      "configFiles": [
        "interface/cmsis-dap.cfg",
        "target/rp2350.cfg"
      ],
      "svdFile": "C:/Users/Vasilis/pico-sdk/src/rp2350/hardware_regs/RP2350.svd",
      "postDebugTask": "reset target"
    }
  ]
}